# ============================================================================
# CampusDebug OS — environment template
# Copy this file to .env and fill in real values. NEVER commit .env.
# ============================================================================

# ---- Server ------------------------------------------------------------------
PORT=5000

# ---- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Security ---------------------------------------------------------------
# Server-side HMAC for gate_passes.hmac_signature (server only)
HMAC_SECRET=
# Gate QR signing key (Ed25519 private key, base64). Server only — never put
# it in a VITE_ variable. Make one with:  node scripts/genPassKeys.js
PASS_SIGNING_PRIVATE_KEY=

# ---- Web Push (VAPID) --------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- SMS gateway (home-grown HTTP gateway app) -------------------------------
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# capcom6 Cloud/Local mode (Basic auth). Cloud URL: https://api.sms-gate.app
# When USER and PASS are both set they are used instead of the token.
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
# Safety net: while set, ONLY these numbers get real SMS. Empty = all dry-run.
SMS_ALLOWLIST=
# Failsafe: a broadcast can never SMS more phones than this.
SMS_MAX_PER_BROADCAST=50
# Canteen operator mobile (must also be in SMS_ALLOWLIST). Empty = disabled.
CANTEEN_OPERATOR_PHONE=

# ---- Frontend (Vite) ---------------------------------------------------------
# Base URL for the API. Empty = same-origin (Express serves dist/ and /api).
# In production keep it EMPTY.
VITE_API_BASE=

# ---- Demo / test fixtures (scripts only) --------------------------------------
DEMO_PASSWORD_WARDEN=
DEMO_PASSWORD_GUARD=
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_DEAN=
TEST_STUDENT_PASSWORD=
